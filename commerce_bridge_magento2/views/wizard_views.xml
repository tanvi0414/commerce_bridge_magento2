<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_bridge_sync_wizard_form" model="ir.ui.view">
        <field name="name">commerce.bridge.sync.wizard.form</field>
        <field name="model">commerce.bridge.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Guided Sync">
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="operation"/>
                        <field name="import_from"/>
                    </group>
                    <group string="Recommended Flow">
                        <field name="note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commerce_bridge_sync_wizard" model="ir.actions.act_window">
        <field name="name">Guided Sync</field>
        <field name="res_model">commerce.bridge.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="commerce_bridge_guided_sync_menu" name="Guided Sync" parent="commerce_bridge_root_menu" action="action_commerce_bridge_sync_wizard" sequence="15" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
</odoo>
