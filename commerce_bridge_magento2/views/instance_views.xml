<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_bridge_instance_kanban" model="ir.ui.view">
        <field name="name">commerce.bridge.instance.kanban</field>
        <field name="model">commerce.bridge.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="base_url"/>
                <field name="connection_state"/>
                <field name="readiness_score"/>
                <field name="pending_job_count"/>
                <field name="failed_job_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <span class="badge text-bg-primary ms-2"><field name="readiness_score"/>%</span>
                            </div>
                            <div class="text-muted mt-2"><field name="base_url"/></div>
                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <span class="badge text-bg-light">Connection: <field name="connection_state"/></span>
                                <span class="badge text-bg-light">Pending: <field name="pending_job_count"/></span>
                                <span class="badge text-bg-light">Failed: <field name="failed_job_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_commerce_bridge_instance_list" model="ir.ui.view">
        <field name="name">commerce.bridge.instance.list</field>
        <field name="model">commerce.bridge.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base_url"/>
                <field name="connection_state"/>
                <field name="readiness_score"/>
                <field name="product_binding_count"/>
                <field name="order_binding_count"/>
                <field name="pending_job_count"/>
                <field name="failed_job_count"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_bridge_instance_form" model="ir.ui.view">
        <field name="name">commerce.bridge.instance.form</field>
        <field name="model">commerce.bridge.instance</field>
        <field name="arch" type="xml">
            <form string="Magento Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_import_stores" type="object" string="Import Stores" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_run_readiness" type="object" string="Check Readiness" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_enqueue_product_import" type="object" string="Import Products" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_enqueue_order_import" type="object" string="Import Orders" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_enqueue_stock_export" type="object" string="Export Stock" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <button name="action_process_queue" type="object" string="Process Queue" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                    <field name="connection_state" widget="statusbar" statusbar_visible="not_tested,ok,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_binding_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_open_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_binding_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_open_jobs" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="pending_job_count" widget="statinfo" string="Pending Jobs"/>
                        </button>
                        <button name="action_open_failed_jobs" type="object" class="oe_stat_button" icon="fa-warning">
                            <field name="failed_job_count" widget="statinfo" string="Failed Jobs"/>
                        </button>
                        <button name="action_open_drift" type="object" class="oe_stat_button" icon="fa-balance-scale">
                            <field name="drift_count" widget="statinfo" string="Stock Drift"/>
                        </button>
                    </div>
                    <h1><field name="name" placeholder="Production Magento"/></h1>
                    <group>
                        <group string="Connection">
                            <field name="enabled"/>
                            <field name="company_id"/>
                            <field name="base_url" placeholder="https://shop.example.com"/>
                            <field name="access_token" password="True" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
                            <field name="store_code"/>
                            <field name="verify_ssl"/>
                            <field name="timeout"/>
                        </group>
                        <group string="Health">
                            <field name="readiness_score" readonly="1"/>
                            <field name="last_readiness_at" readonly="1"/>
                            <field name="last_connection_at" readonly="1"/>
                            <field name="magento_version" readonly="1"/>
                            <field name="last_connection_error" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Simple Setup">
                            <group>
                                <group string="Order Import">
                                    <field name="import_order_from"/>
                                    <field name="default_order_action"/>
                                    <field name="order_total_policy"/>
                                    <field name="order_total_tolerance"/>
                                    <field name="auto_create_products"/>
                                </group>
                                <group string="Stock Export">
                                    <field name="stock_api_mode"/>
                                    <field name="stock_source_code"/>
                                    <field name="warehouse_id"/>
                                    <field name="stock_quantity_field"/>
                                    <field name="safety_stock"/>
                                    <field name="export_stock_only_bound_products"/>
                                </group>
                            </group>
                        </page>
                        <page string="Stores">
                            <group string="Websites">
                                <field name="website_ids" readonly="1">
                                    <list>
                                        <field name="magento_id"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="is_default"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Store Views">
                                <field name="store_view_ids" readonly="1">
                                    <list>
                                        <field name="magento_id"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="is_active"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Sync Defaults">
                            <group>
                                <field name="import_product_from"/>
                                <field name="page_size"/>
                                <field name="last_product_import_at" readonly="1"/>
                                <field name="last_order_import_at" readonly="1"/>
                                <field name="last_stock_export_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes for go-live, custom Magento extensions, tax assumptions, etc."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
