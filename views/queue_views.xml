<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_bridge_queue_job_list" model="ir.ui.view">
        <field name="name">commerce.bridge.queue.job.list</field>
        <field name="model">commerce.bridge.queue.job</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state in ('failed','blocked')" decoration-warning="state == 'retry_waiting'">
                <field name="priority"/>
                <field name="create_date"/>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="magento_id"/>
                <field name="retry_count"/>
                <field name="next_retry_at"/>
                <field name="duration_ms"/>
                <button name="action_process" type="object" string="Run" class="btn-link"/>
                <button name="action_retry" type="object" string="Retry" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_bridge_queue_job_form" model="ir.ui.view">
        <field name="name">commerce.bridge.queue.job.form</field>
        <field name="model">commerce.bridge.queue.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" type="object" string="Run Now" class="btn-primary"/>
                    <button name="action_retry" type="object" string="Retry"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,done,failed,retry_waiting,blocked"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Job">
                            <field name="instance_id"/>
                            <field name="operation"/>
                            <field name="priority"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="magento_id"/>
                            <field name="external_key"/>
                        </group>
                        <group string="Execution">
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_retry_at"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" nolabel="1" widget="text"/>
                        </page>
                        <page string="Response">
                            <field name="response_json" nolabel="1" widget="text" readonly="1"/>
                        </page>
                        <page string="Error Explanation">
                            <group>
                                <field name="error_type" readonly="1"/>
                                <field name="error_message" readonly="1" nolabel="1"/>
                                <field name="help_message" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="level"/>
                                    <field name="message"/>
                                    <field name="endpoint"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commerce_bridge_sync_log_list" model="ir.ui.view">
        <field name="name">commerce.bridge.sync.log.list</field>
        <field name="model">commerce.bridge.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="create_date"/>
                <field name="level"/>
                <field name="instance_id"/>
                <field name="operation"/>
                <field name="message"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="magento_id"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_bridge_sync_log_form" model="ir.ui.view">
        <field name="name">commerce.bridge.sync.log.form</field>
        <field name="model">commerce.bridge.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="job_id"/>
                            <field name="level"/>
                            <field name="operation"/>
                            <field name="endpoint"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="magento_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_json" nolabel="1" widget="text"/>
                        </page>
                        <page string="Response">
                            <field name="response_json" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
