<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_bridge_readiness_list" model="ir.ui.view">
        <field name="name">commerce.bridge.readiness.check.list</field>
        <field name="model">commerce.bridge.readiness.check</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'blocking'" decoration-warning="severity == 'warning'" decoration-success="severity == 'ok'" decoration-muted="state != 'open'">
                <field name="instance_id"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="name"/>
                <field name="affected_count"/>
                <field name="state"/>
                <button name="action_resolve" type="object" string="Resolve" class="btn-link"/>
                <button name="action_ignore" type="object" string="Ignore" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_bridge_readiness_form" model="ir.ui.view">
        <field name="name">commerce.bridge.readiness.check.form</field>
        <field name="model">commerce.bridge.readiness.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" type="object" string="Mark Resolved" class="btn-primary"/>
                    <button name="action_ignore" type="object" string="Ignore"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved,ignored"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="affected_count"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group string="Recommended Action">
                        <field name="action_hint" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
