<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="commerce_bridge_root_menu" name="Magento" sequence="40" groups="commerce_bridge_magento2.group_commerce_bridge_user"
    web_icon="commerce_bridge_magento2,static/description/icon.png"/>

    <record id="action_commerce_bridge_instances" model="ir.actions.act_window">
        <field name="name">Magento Connections</field>
        <field name="res_model">commerce.bridge.instance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Magento 2 connection.</p>
            <p>Use the guided buttons: Test Connection, Import Stores, Check Readiness, then create sync jobs.</p>
        </field>
    </record>

    <record id="action_commerce_bridge_mappings" model="ir.actions.act_window">
        <field name="name">Mapping Center</field>
        <field name="res_model">commerce.bridge.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_product_bindings" model="ir.actions.act_window">
        <field name="name">Magento Products</field>
        <field name="res_model">commerce.bridge.product.binding</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_order_bindings" model="ir.actions.act_window">
        <field name="name">Magento Orders</field>
        <field name="res_model">commerce.bridge.sale.order.binding</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_jobs" model="ir.actions.act_window">
        <field name="name">Sync Jobs</field>
        <field name="res_model">commerce.bridge.queue.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">commerce.bridge.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_readiness" model="ir.actions.act_window">
        <field name="name">Readiness Checks</field>
        <field name="res_model">commerce.bridge.readiness.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commerce_bridge_drift" model="ir.actions.act_window">
        <field name="name">Inventory Drift</field>
        <field name="res_model">commerce.bridge.inventory.drift</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="commerce_bridge_dashboard_menu" name="Dashboard" parent="commerce_bridge_root_menu" action="action_commerce_bridge_instances" sequence="10"/>
    <menuitem id="commerce_bridge_connections_menu" name="Connections" parent="commerce_bridge_root_menu" action="action_commerce_bridge_instances" sequence="20"/>
    <menuitem id="commerce_bridge_mapping_menu" name="Mapping Center" parent="commerce_bridge_root_menu" action="action_commerce_bridge_mappings" sequence="30"/>
    <menuitem id="commerce_bridge_operations_menu" name="Operations" parent="commerce_bridge_root_menu" sequence="40"/>
    <menuitem id="commerce_bridge_products_menu" name="Products" parent="commerce_bridge_operations_menu" action="action_commerce_bridge_product_bindings" sequence="10"/>
    <menuitem id="commerce_bridge_orders_menu" name="Orders" parent="commerce_bridge_operations_menu" action="action_commerce_bridge_order_bindings" sequence="20"/>
    <menuitem id="commerce_bridge_inventory_drift_menu" name="Inventory Drift" parent="commerce_bridge_operations_menu" action="action_commerce_bridge_drift" sequence="30"/>
    <menuitem id="commerce_bridge_queue_menu" name="Sync Jobs" parent="commerce_bridge_root_menu" action="action_commerce_bridge_jobs" sequence="50"/>
    <menuitem id="commerce_bridge_readiness_menu" name="Readiness" parent="commerce_bridge_root_menu" action="action_commerce_bridge_readiness" sequence="60"/>
    <menuitem id="commerce_bridge_logs_menu" name="Logs" parent="commerce_bridge_root_menu" action="action_commerce_bridge_logs" sequence="70" groups="commerce_bridge_magento2.group_commerce_bridge_manager"/>
</odoo>
