<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_bridge_inventory_drift_list" model="ir.ui.view">
        <field name="name">commerce.bridge.inventory.drift.list</field>
        <field name="model">commerce.bridge.inventory.drift</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'ok'" decoration-warning="state == 'warning'" decoration-danger="state in ('critical','not_found')">
                <field name="instance_id"/>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="odoo_qty"/>
                <field name="magento_qty"/>
                <field name="difference"/>
                <field name="magento_source_code"/>
                <field name="state"/>
                <field name="checked_at"/>
                <button name="action_export_odoo_stock" type="object" string="Export Odoo Stock" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_bridge_inventory_drift_form" model="ir.ui.view">
        <field name="name">commerce.bridge.inventory.drift.form</field>
        <field name="model">commerce.bridge.inventory.drift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export_odoo_stock" type="object" string="Export Odoo Stock" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="ok,warning,critical,not_found"/>
                </header>
                <sheet>
                    <h1><field name="sku"/></h1>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="product_id"/>
                            <field name="product_binding_id"/>
                            <field name="magento_source_code"/>
                        </group>
                        <group>
                            <field name="odoo_qty"/>
                            <field name="magento_qty"/>
                            <field name="difference"/>
                            <field name="abs_difference"/>
                            <field name="checked_at"/>
                        </group>
                    </group>
                    <group string="Raw Magento Stock Response">
                        <field name="raw_json" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
